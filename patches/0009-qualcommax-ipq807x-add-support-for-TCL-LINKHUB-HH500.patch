+++ b/target/linux/qualcommax/ipq807x/base-files/etc/board.d/02_network
@@ -13,6 +13,7 @@ ipq807x_setup_interfaces()
 	case "$board" in
 	aliyun,ap8220|\
 	edgecore,eap102|\
+	tcl,linkhub-hh500v|\
 	tplink,deco-x80-5g|\
 	yuncore,ax880|\
 	zte,mf269)
@@ -93,6 +94,10 @@ ipq807x_setup_macs()
 		lan_mac=$(macaddr_add "$wan_mac" 1)
 		label_mac="$wan_mac"
 		;;
+	tcl,linkhub-hh500v)
+		wan_mac=$(mtd_get_mac_binary "0:ART" 0x5e290)
