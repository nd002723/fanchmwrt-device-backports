@@ -0,0 +1,9 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Device Tree Source for Meraki MR70 (Toe Biter) / Go GR60 (Dungbeetle)
+
+#include "qcom-ipq4029-meraki-underdog.dtsi"
+
+/ {
+	model = "Meraki MR70";
+	compatible = "meraki,mr70";
+};
diff --git a/target/linux/ipq40xx/image/generic.mk b/target/linux/ipq40xx/image/generic.mk
index c7587f0ad0b..5342583cfce 100644
--- a/target/linux/ipq40xx/image/generic.mk
+++ b/target/linux/ipq40xx/image/generic.mk
@@ -842,6 +842,14 @@ define Device/meraki_mr33
 endef
 TARGET_DEVICES += meraki_mr33
 
+define Device/meraki_mr70
+	$(call Device/meraki_common)
+	DEVICE_MODEL := MR70
+	DEVICE_DTS_CONFIG := config@5
+	DEVICE_PACKAGES := ipq-wifi-meraki_underdog
+endef
+TARGET_DEVICES += meraki_mr70
+
 define Device/meraki_mr74
 	$(call Device/meraki_common)
 	DEVICE_MODEL := MR74
