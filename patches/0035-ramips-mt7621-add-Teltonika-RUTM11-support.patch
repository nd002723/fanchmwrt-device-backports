 .../base-files/etc/board.d/03_gpio_switches   |   1 +
 .../mt7621/base-files/etc/init.d/bootcount    |   1 +
 .../mt7621/base-files/lib/upgrade/platform.sh |   1 +
 6 files changed, 258 insertions(+)
