 teltonika,rutm30|\
 teltonika,rutm50)
 	ucidef_add_gpio_switch "modem_power" "Modem power button" "modem_power" "1"
diff --git a/target/linux/ramips/mt7621/base-files/etc/init.d/bootcount b/target/linux/ramips/mt7621/base-files/etc/init.d/bootcount
index 72752795518..1fa10b08d3d 100755
--- a/target/linux/ramips/mt7621/base-files/etc/init.d/bootcount
+++ b/target/linux/ramips/mt7621/base-files/etc/init.d/bootcount
@@ -49,6 +49,7 @@ boot() {
 		[ $(printf %d $(fw_printenv -n Image1Stable)) -gt 0 ] || fw_setenv Image1Stable 1
 		[ $(printf %d $(fw_printenv -n Image1Try)) -gt 0 ] && fw_setenv Image1Try 0
 		;;
+	teltonika,rutm11|\
 	teltonika,rutm30|\
 	teltonika,rutm50)
 		#Bootloader expect successfull startup value after update, we need to write success value to bootconfig partition
diff --git a/target/linux/ramips/mt7621/base-files/lib/upgrade/platform.sh b/target/linux/ramips/mt7621/base-files/lib/upgrade/platform.sh
index 4af3db4f3fa..52617bc4264 100644
--- a/target/linux/ramips/mt7621/base-files/lib/upgrade/platform.sh
+++ b/target/linux/ramips/mt7621/base-files/lib/upgrade/platform.sh
@@ -230,6 +230,7 @@ platform_do_upgrade() {
 		zyxel_mstc_upgrade_prepare
 		nand_do_upgrade "$1"
 		;;
+	teltonika,rutm11|\
 	teltonika,rutm30|\
 	teltonika,rutm50)
 		CI_UBIPART="$(cmdline_get_var ubi.mtd)"
