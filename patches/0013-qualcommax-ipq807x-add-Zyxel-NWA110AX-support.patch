+			};
+
+			partition@620000 {
+				label = "mrd_1";
+				reg = <0x620000 0x10000>;
+				read-only;
+			};
+
+			partition@630000 {
+				label = "conf";
+				reg = <0x630000 0x1d0000>;
+				read-only;
+			};
+		};
+	};
+};
+
+&qpic_bam {
+	status = "okay";
+};
+
+&qpic_nand {
+	status = "okay";
+
+	nand@0 {
+		reg = <0>;
+		nand-ecc-step-size = <512>;
+		nand-bus-width = <8>;
+		nand-ecc-strength = <4>;
+		compatible = "fixed-partitions";
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		partition@0 {
+			reg = <0x00 0x3c00000>;
+			label = "rootfs";
+		};
