 	tplink,tl-xdr4288|\
 	tplink,tl-xdr6086|\
@@ -420,6 +421,7 @@ platform_check_image() {
 	qihoo,360t7|\
 	qihoo,360t7-ubi|\
 	routerich,ax3000-ubootmod|\
